#!/usr/bin/env python3
"""Run the factorylink CLI straight from a source checkout.

Identical to the installed ``factorylink`` console script; this wrapper just
puts ``src/`` on the path first so the repository works without installation.
"""

from __future__ import annotations

import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
if (_SRC / "factorylink").is_dir():
    sys.path.insert(0, str(_SRC))

from factorylink.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
